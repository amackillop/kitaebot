#!/usr/bin/env bash
set -euo pipefail

# Migration files under src/**/migrations/ are append-only. Once a
# migration is committed it has been applied to user databases, so
# editing or deleting it would silently desync those copies. New
# migrations land as new files; existing ones are immutable. A pure
# rename (R100) is permitted: applied databases track user_version and
# content, not paths.
mig_changes=$(git diff --cached -M100% --name-status -- ':(glob)src/**/migrations/*.sql' \
    | awk '$1 == "M" || $1 == "D" || ($1 ~ /^R/ && $1 != "R100") {print $0}')
if [ -n "$mig_changes" ]; then
    echo "error: migrations are append-only. rejected:" >&2
    echo "$mig_changes" >&2
    exit 1
fi

